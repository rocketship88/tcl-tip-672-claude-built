+/*
+ *----------------------------------------------------------------------
+ *
+ * SkipExprSubstScan --
+ *
+ *	Helper for FindExprSubstEnd. Scans from src (which is just past an
+ *	opening delimiter) to the first unnested occurrence of the closing
+ *	delimiter 'closer', which is either ')' (for the body of an
+ *	expression) or ']' (for a script inside an expression). Braced words,
+ *	double-quoted strings, backslash sequences and bracketed scripts are
+ *	skipped as units so that a closer inside them is not seen. When the
+ *	closer is ')', nested parentheses are counted.
+ *
+ * Results:
+ *	Pointer to the closing delimiter, or NULL if end was reached first,
+ *	or EXPR_SUBST_TOO_DEEP if "[" was nested more than
+ *	EXPR_SUBST_MAX_SCAN_DEPTH levels (level is the current nesting).
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static const char *
+SkipExprSubstScan(
+    const char *src,
+    const char *end,
+    char closer,
+    int level)
+{
+    int depth = 0;
+
+    if (level > EXPR_SUBST_MAX_SCAN_DEPTH) {
+	return EXPR_SUBST_TOO_DEEP;
+    }
+
+    while (src < end) {
+	switch (*src) {
+	case '\\':
+	    /* Skip the escaped character (if there is one). */
+	    if (src + 1 < end) {
+		src++;
+	    }
+	    break;
+	case '{': {
+	    int braces = 1;
+
+	    src++;
+	    while (src < end) {
+		if (*src == '\\') {
+		    if (src + 1 < end) {
+			src++;
+		    }
+		} else if (*src == '{') {
+		    braces++;
+		} else if (*src == '}' && --braces == 0) {
+		    break;
+		}
+		src++;
+	    }
+	    if (src >= end) {
+		return NULL;
+	    }
+	    break;
+	}
+	case '"':
+	    src++;
+	    while (src < end && *src != '"') {
+		if (*src == '\\') {
+		    if (src + 1 < end) {
+			src++;
+		    }
+		} else if (*src == '[') {
+		    src = SkipExprSubstScan(src + 1, end, ']', level + 1);
+		    if ((src == NULL) || (src == EXPR_SUBST_TOO_DEEP)) {
+			return src;
+		    }
+		}
+		src++;
+	    }
+	    if (src >= end) {
+		return NULL;
+	    }
+	    break;
+	case '[':
+	    src = SkipExprSubstScan(src + 1, end, ']', level + 1);
+	    if ((src == NULL) || (src == EXPR_SUBST_TOO_DEEP)) {
+		return src;
+	    }
+	    break;
+	case '(':
+	    if (closer == ')') {
+		depth++;
+	    }
+	    break;
+	case ')':
+	    if (closer == ')') {
+		if (depth == 0) {
+		    return src;
+		}
+		depth--;
+	    }
+	    break;
+	case ']':
+	    if (closer == ']') {
+		return src;
+	    }
+	    break;
+	}
+	src++;
+    }
+    return NULL;
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
+ * FindExprSubstEnd --
+ *
+ *	Given the text just after the "(" that opens an expression
+ *	substitution, find the matching ")".
+ *
+ * Results:
+ *	Pointer to the matching ")", or NULL if there isn't one.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static const char *
+FindExprSubstEnd(
+    const char *src,
+    const char *end)
+{
+    return SkipExprSubstScan(src, end, ')', 0);
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
